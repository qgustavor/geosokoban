{
  "name": "geosokoban-prototype",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "check": "npm run lint:fix && npm run build",
    "flags": "node scripts/build-flag-manifest.js",
    "levels:export": "node scripts/level-editor.js export",
    "levels:import": "node scripts/level-editor.js import",
    "levels:watch": "node scripts/level-editor.js import levels/editable --story --watch",
    "prebuild": "node scripts/copy-licenses.js",
    "maps:outlines": "node scripts/build-map-outlines.js",
    "biomes:prepare": "node scripts/prepare-biomes.js"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "9.39.0",
    "eslint-plugin-vue": "10.12.1",
    "neostandard": "0.14.1",
    "postcss-html": "1.8.0",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "16.0.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vue-eslint-parser": "10.4.2"
  },
  "dependencies": {
    "flag-icons": "7.6.0",
    "vue": "3.5.45",
    "vue-router": "4.6.3"
  }
}
