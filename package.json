{
  "name": "geosokoban-prototype",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "lint": "bun run lint:js && bun run lint:css",
    "lint:js": "bun --bun eslint .",
    "lint:css": "bun --bun stylelint \"src/**/*.{css,vue}\"",
    "lint:fix": "bun run lint:js --fix && bun run lint:css --fix",
    "check": "bun run lint:fix && bun run build",
    "flags": "bun scripts/build-flag-manifest.js",
    "levels:export": "bun scripts/level-editor.js export",
    "levels:import": "bun scripts/level-editor.js import",
    "levels:watch": "bun scripts/level-editor.js import levels/editable --story --watch",
    "story": "bun run --parallel dev levels:watch",
    "prebuild": "bun scripts/copy-licenses.js",
    "maps:outlines": "bun scripts/build-map-outlines.js",
    "biomes:prepare": "bun scripts/prepare-biomes.js"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "9.39.0",
    "eslint-plugin-vue": "10.12.1",
    "neostandard": "0.14.1",
    "postcss-html": "1.8.0",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "16.0.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vue-eslint-parser": "10.4.2"
  },
  "dependencies": {
    "flag-icons": "7.6.0",
    "vue": "3.5.45",
    "vue-router": "4.6.3"
  }
}
